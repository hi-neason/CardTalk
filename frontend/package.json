{
  "name": "@cardtalk/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "build:h5": "uni build && node ../scripts/build-offline.mjs",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "build:app:android": "uni build -p app-android --outDir dist/build/app-android",
    "build:app:ios": "uni build -p app-ios --outDir dist/build/app-ios",
    "dev:app-harmony": "uni -p app-harmony",
    "build:app-harmony": "uni build -p app-harmony"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-harmony": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-uts-v1": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/node": "22.10.2",
    "@vue/runtime-core": "3.4.21",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "4.1.11",
    "vue-tsc": "2.1.10"
  }
}
