# Copy to backend/.env, fill secrets locally, then run npm run dev:backend from the repo root.
# The launcher loads this file as data without shell evaluation; do not source it.
# This example contains no real credentials. Keep .env out of version control.
CARDTALK_BIND_ADDRESS=127.0.0.1
PORT=8080
CARDTALK_DATA_FILE=./data/trial-metadata.json
CARDTALK_DAILY_LIMIT=20

# Defaults verified against DeepSeek's official model/pricing documentation.
CARDTALK_LLM_BASE_URL=https://api.deepseek.com
CARDTALK_LLM_MODEL=deepseek-flash
CARDTALK_LLM_API_KEY=
CARDTALK_LLM_TIMEOUT_SECONDS=30

# Xfyun super-human TTS, separate from the expansion model.
# Credentials are from your Xfyun product console; never put them in client code.
CARDTALK_XFYUN_APP_ID=
CARDTALK_XFYUN_API_KEY=
CARDTALK_XFYUN_API_SECRET=
CARDTALK_XFYUN_ENGINE=super-smart
CARDTALK_XFYUN_VCN=x6_lingxiaoxuan_pro
CARDTALK_XFYUN_TIMEOUT_SECONDS=30
# Leave endpoint empty to select the official endpoint for the engine.
CARDTALK_XFYUN_ENDPOINT=
# Optional already-authorized MULTI-STYLE voice resource (omni_v1), not ordinary clone.
# Set ENGINE=voice-clone and RESOURCE_ID to enable style-based emotion synthesis.
# This application does not record, train, create or manage voice clones.
CARDTALK_XFYUN_RESOURCE_ID=

# Independent LOCAL DEVELOPMENT capability switches, not production licenses.
# Restart the backend and refresh trial-session capabilities after changing them.
CARDTALK_PROFILE_MANAGEMENT_ENABLED=false
CARDTALK_SCENARIO_MANAGEMENT_ENABLED=false
CARDTALK_CUSTOM_CARDS_ENABLED=true
# Enables client-local reports; no communication history is uploaded for analysis.
CARDTALK_ANALYTICS_ENABLED=false

# Local single-process family account store. Production needs HTTPS, explicit UI origins,
# secure cookies, controlled registration, and a production database repository.
CARDTALK_FAMILY_DATA_FILE=./data/families.json
CARDTALK_FAMILY_REGISTRATION_ENABLED=true
CARDTALK_FAMILY_SESSION_SECONDS=604800
CARDTALK_FAMILY_COOKIE_SECURE=false
CARDTALK_FAMILY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Use postgres for a normalized, transactional multi-instance family repository.
# Existing JSON is not automatically imported or overwritten when switching modes.
CARDTALK_FAMILY_REPOSITORY_MODE=json
CARDTALK_FAMILY_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/cardtalk
CARDTALK_FAMILY_JDBC_USER=cardtalk
CARDTALK_FAMILY_JDBC_PASSWORD=

# Immutable local family images, single application instance only.
CARDTALK_ASSET_STORE_MODE=local
CARDTALK_ASSET_DIRECTORY=./data/assets
CARDTALK_ASSET_MAX_BYTES=16777216
CARDTALK_ASSET_MAX_DIMENSION=16384
CARDTALK_ASSET_MAX_PIXELS=40000000

# Count-only DeepSeek report explanations; requires analytics capability.
# Development quota is memory-only and resets on restart (not a production license).
CARDTALK_REPORT_DAILY_LIMIT=5
CARDTALK_REPORT_TIMEOUT_SECONDS=30
CARDTALK_REPORT_MAX_CONCURRENT=2

# Explicit cloud workspace; requires PostgreSQL mode. Login never uploads local data.
CARDTALK_CLOUD_ENABLED=false
# Shared immutable metadata requires FAMILY_REPOSITORY_MODE=postgres.
CARDTALK_ASSET_METADATA_MODE=json
# Existing S3 bucket only; application never creates buckets or public ACLs.
CARDTALK_S3_ENDPOINT=
CARDTALK_S3_REGION=us-east-1
CARDTALK_S3_BUCKET=
CARDTALK_S3_ACCESS_KEY=
CARDTALK_S3_SECRET_KEY=
CARDTALK_S3_PATH_STYLE=true
CARDTALK_S3_ALLOW_LOOPBACK_HTTP=false
CARDTALK_S3_TIMEOUT_SECONDS=30

# false keeps development access; true requires PostgreSQL and active grants for cloud profile/scene/report writes.
# Existing data reads and basic room/card sync remain available after entitlement expiry.
CARDTALK_BILLING_ENFORCED=false
CARDTALK_BILLING_PRODUCTS_FILE=

CARDTALK_BILLING_OPERATOR_ACCOUNT_IDS=

CARDTALK_BILLING_NOTIFY_URL=

# H5 provider supports pinned WeChat public-key mode, not legacy certificates.
CARDTALK_BILLING_PROVIDER=none
CARDTALK_WECHAT_MCHID=
CARDTALK_WECHAT_APPID=
CARDTALK_WECHAT_MERCHANT_SERIAL=
CARDTALK_WECHAT_PRIVATE_KEY_FILE=
CARDTALK_WECHAT_PUBLIC_KEYS_FILE=
CARDTALK_WECHAT_API_V3_KEY=
CARDTALK_WECHAT_ENDPOINT=https://api.mch.weixin.qq.com
CARDTALK_WECHAT_ALLOW_LOOPBACK_HTTP=false
CARDTALK_WECHAT_TIMEOUT_SECONDS=15
CARDTALK_WECHAT_MAX_CONCURRENT=4

# Report quota metadata only; use postgres in production (reuses FAMILY_JDBC_*).
CARDTALK_REPORT_QUOTA_MODE=memory

# Explicit postgres persists anonymous tokens and expansion quota, reusing FAMILY_JDBC_*.
CARDTALK_TRIAL_REPOSITORY_MODE=json

# Support ticket workflow requires PostgreSQL; operators are independently configured with CARDTALK_SUPPORT_OPERATOR_ACCOUNT_IDS.
CARDTALK_SUPPORT_ENABLED=false
CARDTALK_SUPPORT_DAILY_LIMIT=5
CARDTALK_SUPPORT_RETENTION_DAYS=90

# Runtime metrics are off by default; uses CARDTALK_BILLING_OPERATOR_ACCOUNT_IDS.
CARDTALK_METRICS_ENABLED=false

CARDTALK_SUPPORT_OPERATOR_ACCOUNT_IDS=
CARDTALK_METRICS_OPERATOR_ACCOUNT_IDS=

# JSON voice allowlist for the selected Xfyun engine; empty keeps legacy single-voice behavior.
CARDTALK_VOICE_CATALOG_FILE=
