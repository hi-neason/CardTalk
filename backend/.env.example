# Copy to backend/.env, fill secrets locally, then run npm run dev:backend from the repo root.
# The launcher loads this file as data without shell evaluation; do not source it.
# This example contains no real credentials. Keep .env out of version control.
CARDTALK_BIND_ADDRESS=127.0.0.1
PORT=8080
CARDTALK_DATA_FILE=./data/trial-metadata.json
CARDTALK_DAILY_LIMIT=20

# Defaults verified against DeepSeek's official model/pricing documentation.
CARDTALK_LLM_BASE_URL=https://api.deepseek.com
CARDTALK_LLM_MODEL=deepseek-flash
CARDTALK_LLM_API_KEY=
CARDTALK_LLM_TIMEOUT_SECONDS=30

# Xfyun super-human TTS, separate from the expansion model.
# Credentials are from your Xfyun product console; never put them in client code.
CARDTALK_XFYUN_APP_ID=
CARDTALK_XFYUN_API_KEY=
CARDTALK_XFYUN_API_SECRET=
CARDTALK_XFYUN_ENGINE=super-smart
CARDTALK_XFYUN_VCN=x6_lingxiaoxuan_pro
CARDTALK_XFYUN_TIMEOUT_SECONDS=30
# Leave endpoint empty to select the official endpoint for the engine.
CARDTALK_XFYUN_ENDPOINT=
# Optional already-authorized MULTI-STYLE voice resource (omni_v1), not ordinary clone.
# Set ENGINE=voice-clone and RESOURCE_ID to enable style-based emotion synthesis.
# This application does not record, train, create or manage voice clones.
CARDTALK_XFYUN_RESOURCE_ID=

# Independent LOCAL DEVELOPMENT capability switches, not production licenses.
# Restart the backend and refresh trial-session capabilities after changing them.
CARDTALK_PROFILE_MANAGEMENT_ENABLED=false
CARDTALK_SCENARIO_MANAGEMENT_ENABLED=false
CARDTALK_CUSTOM_CARDS_ENABLED=true
