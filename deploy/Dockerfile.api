ARG CARDTALK_IMAGE_REGISTRY=docker.io/library
FROM ${CARDTALK_IMAGE_REGISTRY}/maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /source
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
RUN mvn -B -DskipTests package

FROM ${CARDTALK_IMAGE_REGISTRY}/eclipse-temurin:21-jre
RUN groupadd --system --gid 10001 cardtalk && useradd --system --uid 10001 --gid cardtalk cardtalk && mkdir /data && chown cardtalk:cardtalk /data
WORKDIR /app
COPY --from=build /source/target/cardtalk-api-0.1.0.jar /app/api.jar
USER cardtalk
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/api.jar"]
